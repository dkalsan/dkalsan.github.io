---
import { site } from '../../data/site';
---

<section class="hero container">
  <div class="hero__text">
    <span class="eyebrow">{site.bio}</span>
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__sub">
      {site.employer} · {site.location}
    </p>
    <div class="hero__meta">
      {site.affiliations.map((affiliation) => <p>{affiliation}</p>)}
      <p>
        Advised by <a href={site.advisor.url} class="link-accent" target="_blank" rel="noopener noreferrer">{site.advisor.name}</a>
      </p>
    </div>
    <div class="hero__actions">
      <a href="/cv/" class="button button--accent">View CV</a>
      <a href={`mailto:${site.email}`} class="button">Email me</a>
      <a href="/publications/" class="button">Publications →</a>
    </div>
  </div>
  <div class="hero__photo-wrap">
    <img src="/images/bio-photo-portrait.jpg" alt={site.name} class="hero__photo" width="900" height="1349" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-6) var(--space-5);
  }

  .hero__name {
    font-size: var(--size-hero);
    margin-block: var(--space-1) var(--space-2);
  }

  .hero__sub {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: var(--space-1);
  }

  .hero__meta {
    color: var(--color-text-muted);
    font-size: var(--size-small);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .hero__photo-wrap {
    justify-self: center;
    width: 100%;
    max-width: 20rem;
  }

  .hero__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 1.5rem;
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      padding-block: var(--space-7) var(--space-6);
    }

    .hero__photo-wrap {
      justify-self: end;
      max-width: 22rem;
    }
  }
</style>
