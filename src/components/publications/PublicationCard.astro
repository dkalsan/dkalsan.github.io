---
import type { CollectionEntry } from 'astro:content';
import { site } from '../../data/site';

interface Props {
  entry: CollectionEntry<'publications'>;
}
const { entry } = Astro.props;
const { title, venue, date, authors, excerpt, placeholder, oral, teaserImage } = entry.data;

const categoryLabel: Record<string, string> = {
  conference: 'Conference Paper',
  preprint: 'Preprint',
};

const hasSharedAuthor = authors.some((author) => author.endsWith('*'));
---

<article class="pub-card">
  <div class="pub-card__media">
    {
      teaserImage ? (
        <img src={teaserImage} alt="" class="pub-card__teaser" width="320" height="220" />
      ) : (
        <div class="pub-card__teaser-placeholder">Teaser image</div>
      )
    }
  </div>
  <div class="pub-card__body">
    <div class="pub-card__meta">
      <span class="eyebrow">{categoryLabel[entry.data.category]}</span>
      {oral && <span class="oral-tag">Oral</span>}
      {placeholder && <span class="placeholder-badge">Placeholder</span>}
    </div>
    <h3 class="pub-card__title">
      <a href={`/publications/${entry.id}/`} class="link-accent">{title}</a>
    </h3>
    <p class="pub-card__venue">{venue} · {date.getFullYear()}</p>
    <p class="pub-card__authors">
      {authors.map((author, i) => (
        <>
          {i > 0 && ', '}
          {(author.endsWith('*') ? author.slice(0, -1) : author) === site.name ? <strong>{author}</strong> : author}
        </>
      ))}
      {hasSharedAuthor && <span class="pub-card__footnote"> · * Equal contribution</span>}
    </p>
    <p class="pub-card__excerpt">{excerpt}</p>
  </div>
</article>

<style>
  .pub-card {
    display: flex;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .pub-card__media {
    flex-shrink: 0;
    width: 11rem;
  }

  .pub-card__teaser {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .pub-card__teaser-placeholder {
    width: 100%;
    aspect-ratio: 16 / 11;
    border: 1px dashed var(--color-border);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-1);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .pub-card__body {
    min-width: 0;
    flex: 1;
  }

  .pub-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .pub-card__meta .eyebrow {
    margin-bottom: 0;
  }

  .oral-tag {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: 999px;
    padding: 0.15em 0.65em;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pub-card__title {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
  }

  .pub-card__venue {
    color: var(--color-text-muted);
    font-size: var(--size-small);
    margin-bottom: 0.5rem;
  }

  .pub-card__authors {
    font-size: var(--size-small);
    color: var(--color-text-muted);
    margin-bottom: 0.6rem;
  }

  .pub-card__footnote {
    font-style: italic;
  }

  .pub-card__excerpt {
    max-width: var(--content-width);
  }

  @media (max-width: 32rem) {
    .pub-card {
      flex-direction: column;
    }

    .pub-card__media {
      width: 100%;
      max-width: 14rem;
    }
  }
</style>
