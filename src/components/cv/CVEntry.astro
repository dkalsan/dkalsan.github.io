---
import type { CVEntry } from '../../data/cv';

interface Props {
  entry: CVEntry;
}
const { entry } = Astro.props;
---

<div class="cv-entry">
  <div class="cv-entry__dates">
    {entry.start}{entry.end ? `–${entry.end}` : ''}
  </div>
  <div class="cv-entry__body">
    <div class="cv-entry__heading">
      <h4 class="cv-entry__title">{entry.title}</h4>
      {entry.placeholder && <span class="placeholder-badge">Placeholder</span>}
    </div>
    <p class="cv-entry__org">
      {entry.org}{entry.location && ` · ${entry.location}`}
    </p>
    {entry.description && <p class="cv-entry__description">{entry.description}</p>}
  </div>
</div>

<style>
  .cv-entry {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .cv-entry__dates {
    color: var(--color-text-muted);
    font-size: var(--size-small);
    font-weight: 600;
    white-space: nowrap;
  }

  .cv-entry__heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .cv-entry__title {
    font-size: 1.1rem;
  }

  .cv-entry__org {
    color: var(--color-text-muted);
    font-size: var(--size-small);
    margin-top: 0.2rem;
  }

  .cv-entry__description {
    margin-top: 0.4rem;
  }

  @media (max-width: 30rem) {
    .cv-entry {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
