  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect x="2.5" y="4.5" width="19" height="15" rx="2"></rect>
  <path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path>
</svg>
