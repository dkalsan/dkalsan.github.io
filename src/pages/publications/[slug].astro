---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('publications');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, venue, category, date, authors, citation, paperUrl, slidesUrl, bibtexUrl, placeholder } = entry.data;
const { Content } = await render(entry);

const categoryLabel: Record<string, string> = {
  journal: 'Journal Article',
  conference: 'Conference Paper',
  book: 'Book Chapter',
};
---

<BaseLayout title={title} description={entry.data.excerpt}>
  <article class="container page">
    <div class="page__meta">
      <span class="eyebrow">{categoryLabel[category]}</span>
      {placeholder && <span class="placeholder-badge">Placeholder</span>}
    </div>
    <h1 class="page__title">{title}</h1>
    <p class="page__venue">{venue} · {date.getFullYear()}</p>
    <p class="page__authors">{authors.join(', ')}</p>

    <div class="page__links">
      {paperUrl && <a href={paperUrl} class="button">Paper</a>}
      {slidesUrl && <a href={slidesUrl} class="button">Slides</a>}
      {bibtexUrl && <a href={bibtexUrl} class="button">BibTeX</a>}
    </div>

    <div class="page__body">
      <Content />
    </div>

    <blockquote class="page__citation">{citation}</blockquote>

    <a href="/publications/" class="link-accent page__back">&larr; Back to publications</a>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-5) var(--space-6);
    max-width: var(--content-width);
  }

  .page__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .page__title {
    font-size: var(--size-h1);
    margin-bottom: var(--space-2);
  }

  .page__venue {
    color: var(--color-text-muted);
  }

  .page__authors {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .page__links {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .page__body {
    margin-bottom: var(--space-4);
  }

  .page__citation {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-2);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: var(--size-small);
  }

  .page__back {
    font-size: var(--size-small);
    font-weight: 600;
  }
</style>
