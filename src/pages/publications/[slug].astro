---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('publications');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  title,
  venue,
  category,
  date,
  authors,
  citation,
  oral,
  teaserImage,
  paperUrl,
  slidesUrl,
  bibtexUrl,
  projectUrl,
  githubUrl,
  arxivUrl,
  placeholder,
} = entry.data;
const { Content } = await render(entry);

const categoryLabel: Record<string, string> = {
  conference: 'Conference Paper',
  preprint: 'Preprint',
};

const hasSharedAuthor = authors.some((author) => author.endsWith('*'));
---

<BaseLayout title={title} description={entry.data.excerpt}>
  <article class="container page">
    <div class="page__meta">
      <span class="eyebrow">{categoryLabel[category]}</span>
      {oral && <span class="oral-tag">Oral</span>}
      {placeholder && <span class="placeholder-badge">Placeholder</span>}
    </div>
    <h1 class="page__title">{title}</h1>
    <p class="page__venue">{venue} · {date.getFullYear()}</p>
    <p class="page__authors">
      {authors.map((author, i) => (
        <>
          {i > 0 && ', '}
          {(author.endsWith('*') ? author.slice(0, -1) : author) === site.name ? <strong>{author}</strong> : author}
        </>
      ))}
      {hasSharedAuthor && <span class="page__footnote"> · * Equal contribution</span>}
    </p>

    {
      teaserImage ? (
        <img src={teaserImage} alt="" class="page__teaser" width="960" height="540" />
      ) : (
        <div class="page__teaser-placeholder">Teaser image</div>
      )
    }

    <div class="page__links">
      {paperUrl && <a href={paperUrl} class="button">Paper</a>}
      {arxivUrl && <a href={arxivUrl} class="button">arXiv</a>}
      {projectUrl && <a href={projectUrl} class="button">Project Page</a>}
      {githubUrl && <a href={githubUrl} class="button">Code</a>}
      {slidesUrl && <a href={slidesUrl} class="button">Slides</a>}
      {bibtexUrl && <a href={bibtexUrl} class="button">BibTeX</a>}
    </div>

    <div class="page__body">
      <Content />
    </div>

    <blockquote class="page__citation">{citation}</blockquote>

    <a href="/publications/" class="link-accent page__back">&larr; Back to publications</a>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-5) var(--space-6);
    max-width: var(--content-width);
  }

  .page__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .page__meta .eyebrow {
    margin-bottom: 0;
  }

  .oral-tag {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: 999px;
    padding: 0.15em 0.65em;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .page__title {
    font-size: var(--size-h1);
    margin-bottom: var(--space-2);
  }

  .page__venue {
    color: var(--color-text-muted);
  }

  .page__authors {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .page__footnote {
    font-style: italic;
  }

  .page__teaser {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 1rem;
    margin-bottom: var(--space-3);
  }

  .page__teaser-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--color-border);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--size-small);
    margin-bottom: var(--space-3);
  }

  .page__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .page__body {
    margin-bottom: var(--space-4);
  }

  .page__citation {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-2);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: var(--size-small);
  }

  .page__back {
    font-size: var(--size-small);
    font-weight: 600;
  }
</style>
