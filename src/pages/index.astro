---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/home/Banner.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedLinks from '../components/home/FeaturedLinks.astro';
import Reveal from '../components/sections/Reveal.astro';
---

<BaseLayout>
  <Banner />
  <Hero />

  <Reveal as="section" class="about container">
    <span class="eyebrow">About</span>
    <p>
      <span class="placeholder-badge">Placeholder</span> bio paragraph — replace with a real summary
      of research interests, background, and current focus.
    </p>
  </Reveal>

  <Reveal as="section" class="container links-section">
    <FeaturedLinks />
  </Reveal>
</BaseLayout>

<style>
  :global(.about) {
    padding-block: var(--space-4);
    max-width: var(--content-width);
  }

  :global(.about p) {
    margin-top: var(--space-2);
  }

  :global(.links-section) {
    padding-block: var(--space-5) var(--space-6);
  }
</style>
