---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import Reveal from '../components/sections/Reveal.astro';
import CVSection from '../components/cv/CVSection.astro';
import { cv } from '../data/cv';
import { site } from '../data/site';
---

<BaseLayout title="CV" description={`Curriculum vitae of ${site.name}.`}>
  <div class="container page" data-rush-target>
    <Reveal class="page__heading-row">
      <SectionHeading eyebrow="Background" title="CV" />
      <button type="button" class="button rush-toggle" data-rush-toggle aria-pressed="false">⚡ Rush Mode</button>
    </Reveal>

    <Reveal as="section">
      <CVSection title="Education" entries={cv.education} />
    </Reveal>

    <Reveal as="section">
      <CVSection title="Positions" entries={cv.positions} />
    </Reveal>

    <Reveal as="section" class="cv-skills">
      <h3 class="cv-skills__title">Skills</h3>
      <ul class="cv-skills__list">
        {cv.skills.map((skill) => <li class="cv-skills__item">{skill}</li>)}
      </ul>
    </Reveal>
  </div>
  <script>
    import '../scripts/rush-mode.ts';
  </script>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-5) var(--space-6);
  }

  :global(.page__heading-row) {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .rush-toggle {
    margin-bottom: var(--space-4);
  }

  .cv-skills__title {
    font-size: var(--size-h2);
    margin-bottom: var(--space-2);
  }

  .cv-skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cv-skills__item {
    font-size: var(--size-small);
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
  }
</style>
